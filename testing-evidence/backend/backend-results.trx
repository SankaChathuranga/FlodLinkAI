info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@workflowRunId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT d."Id", d."Decision", d."ApprovalNotes", d."DispatchedAt", d."CreatedAt"
      FROM "Dispatches" AS d
      WHERE d."WorkflowRunId" = @workflowRunId
      ORDER BY d."CreatedAt" DESC
      LIMIT 1
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@workflowRunId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT a."CreatedAt"
      FROM "AuditTrail" AS a
      LEFT JOIN "Dispatches" AS d ON a."DispatchId" = d."Id"
      WHERE a."EventType" = 'DeliveryConfirmed' AND d."Id" IS NOT NULL AND d."WorkflowRunId" = @workflowRunId
      ORDER BY a."CreatedAt" DESC
      LIMIT 1
