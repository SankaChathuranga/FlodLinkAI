      CREATE TABLE "AllocationProposals" (
          "Id" integer GENERATED BY DEFAULT AS IDENTITY,
          "WorkflowRunId" uuid NOT NULL,
          "DepotId" integer NOT NULL,
          "ShelterId" integer NOT NULL,
          "ItemName" character varying(100) NOT NULL,
          "Quantity" double precision NOT NULL,
          "Status" character varying(20) NOT NULL,
          "CreatedAt" timestamp with time zone NOT NULL,
          CONSTRAINT "PK_AllocationProposals" PRIMARY KEY ("Id"),
          CONSTRAINT "FK_AllocationProposals_Depots_DepotId" FOREIGN KEY ("DepotId") REFERENCES "Depots" ("Id") ON DELETE RESTRICT,
          CONSTRAINT "FK_AllocationProposals_Shelters_ShelterId" FOREIGN KEY ("ShelterId") REFERENCES "Shelters" ("Id") ON DELETE RESTRICT,
          CONSTRAINT "FK_AllocationProposals_WorkflowRuns_WorkflowRunId" FOREIGN KEY ("WorkflowRunId") REFERENCES "WorkflowRuns" ("Id") ON DELETE CASCADE
      );
