      SELECT setval(
          pg_get_serial_sequence('"Depots"', 'Id'),
          GREATEST(
              (SELECT MAX("Id") FROM "Depots") + 1,
              nextval(pg_get_serial_sequence('"Depots"', 'Id'))),
          false);
      SELECT setval(
          pg_get_serial_sequence('"Users"', 'Id'),
          GREATEST(
              (SELECT MAX("Id") FROM "Users") + 1,
              nextval(pg_get_serial_sequence('"Users"', 'Id'))),
          false);
      SELECT setval(
          pg_get_serial_sequence('"InventoryItems"', 'Id'),
          GREATEST(
              (SELECT MAX("Id") FROM "InventoryItems") + 1,
              nextval(pg_get_serial_sequence('"InventoryItems"', 'Id'))),
          false);
      SELECT setval(
          pg_get_serial_sequence('"Shelters"', 'Id'),
          GREATEST(
              (SELECT MAX("Id") FROM "Shelters") + 1,
              nextval(pg_get_serial_sequence('"Shelters"', 'Id'))),
          false);
      SELECT setval(
          pg_get_serial_sequence('"Reports"', 'Id'),
          GREATEST(
              (SELECT MAX("Id") FROM "Reports") + 1,
              nextval(pg_get_serial_sequence('"Reports"', 'Id'))),
          false);
