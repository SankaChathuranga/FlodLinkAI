      SELECT r."Id", r."CreatedAt", r."GpsLat", r."GpsLng", r."NeedType", r."PhotoUrl", r."QuantityNeeded", r."ReportedBy", r."ShelterId", r."Status", r."UrgencyLevel", s."Id", s."Capacity", s."ContactVolunteerId", s."CreatedAt", s."CurrentOccupancy", s."Latitude", s."Longitude", s."Name", s."Status", s."UpdatedAt", u."Id", u."CreatedAt", u."HashedPassword", u."Name", u."Phone", u."Role"
      FROM "Reports" AS r
      INNER JOIN "Shelters" AS s ON r."ShelterId" = s."Id"
      INNER JOIN "Users" AS u ON r."ReportedBy" = u."Id"
      WHERE lower(r."Status") = @ToLower
      ORDER BY r."CreatedAt" DESC
