      CREATE TABLE "Reports" (
          "Id" integer GENERATED BY DEFAULT AS IDENTITY,
          "ShelterId" integer NOT NULL,
          "ReportedBy" integer NOT NULL,
          "NeedType" character varying(50) NOT NULL,
          "QuantityNeeded" integer NOT NULL,
          "UrgencyLevel" integer NOT NULL,
          "PhotoUrl" character varying(500),
          "GpsLat" double precision,
          "GpsLng" double precision,
          "Status" character varying(20) NOT NULL,
          "CreatedAt" timestamp with time zone NOT NULL,
          CONSTRAINT "PK_Reports" PRIMARY KEY ("Id"),
          CONSTRAINT "FK_Reports_Shelters_ShelterId" FOREIGN KEY ("ShelterId") REFERENCES "Shelters" ("Id") ON DELETE CASCADE,
          CONSTRAINT "FK_Reports_Users_ReportedBy" FOREIGN KEY ("ReportedBy") REFERENCES "Users" ("Id") ON DELETE RESTRICT
      );
